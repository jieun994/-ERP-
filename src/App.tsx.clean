                        type="checkbox"
                        className="h-4 w-4 rounded border-[#D1D6DB] text-[#008d75] focus:ring-0 cursor-pointer accent-[#008d75]"
                      />
                      <label htmlFor="rememberMe" className="ml-2 text-sm text-[#4E5968] cursor-pointer">
                        아이디 저장
                      </label>
                    </div>
                    <button
                      type="button"
                      onClick={() => setView('reset_email')}

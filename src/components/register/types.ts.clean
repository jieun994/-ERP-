export interface EnterpriseBlock {
  id: string;
  name: string;
  bizNumber: string;
  corpNumber: string;
}

export interface ExcelRow extends EnterpriseBlock {
  selected: boolean;
  errors?: Record<string, string>;
}

export interface VanInfo {
  van: string;
  won: string;
  foreign: string;
  foreignLoan: string;
  payment: string;
  virtual: string;
}

export interface CommonSettings {
  interfaceMethod: string;
  baseUrl: string;
  authMethod: string;
}

export interface EnterpriseParams {
  [key: string]: string;
}
